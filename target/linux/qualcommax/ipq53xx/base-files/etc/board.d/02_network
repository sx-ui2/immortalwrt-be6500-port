#!/bin/sh

. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

board_config_update

case "$(board_name)" in
jdcloud,be6500)
	# Diagnostic native-DTS images expose either the raw NSS-DP links or DSA
	# ports.  The normal BE6500 image uses the factory QSDK/SSDK topology:
	# eth0 is WAN and the QCA8386 behind eth1 provides three LAN ports.
	# The production/MHT overlay inherits the older diagnostic marker from its
	# parent DTS.  Its explicit port-stage marker must take precedence so a
	# clean boot receives the working factory/QWRT VLAN topology.
	if [ -e /proc/device-tree/be6500,port-stage ]; then
		ucidef_set_interfaces_lan_wan "eth1.1" "eth0"
		ucidef_add_switch "switch1" \
			"0@eth1" "3:lan:1" "2:lan:2" "1:lan:3"
	elif [ -e /proc/device-tree/be6500,mdio-staged ]; then
		ucidef_set_interfaces_lan_wan "eth1" "eth0"
	elif [ -e /proc/device-tree/be6500,dsa-noreset ] || \
	     [ -e /proc/device-tree/be6500,dsa-preserve ] || \
	     [ -e /proc/device-tree/be6500,dsa-ssdk-preserve ]; then
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3" "wan"
	else
		# This is the mapping used by the working factory/QWRT firmware.  The
		# CPU port is tagged and physical switch ports 1-3 are all LAN.
		ucidef_set_interfaces_lan_wan "eth1.1" "eth0"
		ucidef_add_switch "switch1" \
			"0@eth1" "3:lan:1" "2:lan:2" "1:lan:3"
	fi
	# Keep the factory identity rule proven by the working QWRT image:
	# WAN is factory[0], LAN is WAN + 1.
	wan_mac="$(mmc_get_mac_binary factory 0x0)"
	if [ -n "$wan_mac" ] && [ "$wan_mac" != "00:00:00:00:00:00" ]; then
		lan_mac="$(macaddr_add "$wan_mac" 1)"
		ucidef_set_interface_macaddr "wan" "$wan_mac"
		ucidef_set_interface_macaddr "lan" "$lan_mac"
	fi
	;;
esac

board_config_flush

exit 0
