#!/bin/sh /etc/rc.common

START=78
STOP=12

RUNTIME=/usr/libexec/be6500-qmodem-runtime

start()
{
	# USB interface drivers settle after rcS has started. Do not keep a watcher
	# alive; the hotplug hook handles devices that appear later.
	( sleep 5; "$RUNTIME" boot ) >/dev/null 2>&1 &
}

stop()
{
	"$RUNTIME" stop >/dev/null 2>&1
}
