#!/bin/sh

# Set the image default only when root still has the factory empty/locked
# password. A sysupgrade that restores an existing password is left intact.
root_hash="$(awk -F: '$1 == "root" { print $2; exit }' /etc/shadow 2>/dev/null)"

case "$root_hash" in
	""|"!"|"*")
		printf '%s\n' password password | passwd root >/dev/null 2>&1 || exit 1
		logger -t be6500-default-password "installed image default root password" 2>/dev/null || true
		;;
esac

exit 0
