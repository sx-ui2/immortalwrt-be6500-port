#!/bin/sh

# Select the Qualcomm PPE/ECM forwarding path without depending on a proxy
# package or on a particular WAN topology. PPPoE may run directly on an
# Ethernet port or through one (or more) VLAN devices. ECM/PPE accelerates the
# forwarding path without requiring a root PPE qdisc; hardware shaping is
# configured separately by be6500-qos-apply only when a limit is enabled.

state=/tmp/be6500-accel-state
lock=/var/lock/be6500-accel.lock
map_major=/sys/kernel/debug/qca-nss-ppe/ppe_drv_if_map/ppe_if_map
map_node=/dev/be6500-ppe-if-map

mkdir -p /var/lock
exec 9>"$lock"
flock -x 9

log() {
	logger -t be6500-accel -- "$*"
}

write_state() {
	local mode="$1" reason="$2"
	{
		echo "mode=$mode"
		[ -n "$reason" ] && echo "reason=$reason"
		[ -n "$wan_proto" ] && echo "wan_proto=$wan_proto"
		[ -n "$wan_l3" ] && echo "wan_l3=$wan_l3"
		[ -n "$wan_device" ] && echo "wan_device=$wan_device"
		[ -n "$wan_physical" ] && echo "wan_physical=$wan_physical"
		[ -n "$wan_layers" ] && echo "wan_layers=$wan_layers"
		[ -n "$wan_vlan" ] && echo "wan_vlan=$wan_vlan"
	} > "$state"
}

set_fw4_offload() {
	local wanted="$1"
	FW4_CHANGED=0
	[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = "$wanted" ] || {
		uci -q set firewall.@defaults[0].flow_offloading="$wanted"
		FW4_CHANGED=1
	}
	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = "$wanted" ] || {
		uci -q set firewall.@defaults[0].flow_offloading_hw="$wanted"
		FW4_CHANGED=1
	}
	[ "$FW4_CHANGED" = 0 ] || uci -q commit firewall
}

reload_fw4_if_changed() {
	[ "$FW4_CHANGED" = 1 ] || return 0
	ubus -t 2 list firewall >/dev/null 2>&1 || return 0
	fw4 reload >/dev/null 2>&1 || \
		ubus call firewall reload >/dev/null 2>&1 || \
		/etc/init.d/firewall reload >/dev/null 2>&1 || true
}

stop_ecm() {
	[ -d /sys/module/ecm ] || return 0
	[ -w /sys/kernel/debug/ecm/front_end_ipv4_stop ] && echo 1 > /sys/kernel/debug/ecm/front_end_ipv4_stop
	[ -w /sys/kernel/debug/ecm/front_end_ipv6_stop ] && echo 1 > /sys/kernel/debug/ecm/front_end_ipv6_stop
	[ -w /sys/kernel/debug/ecm/ecm_db/defunct_all ] && echo 1 > /sys/kernel/debug/ecm/ecm_db/defunct_all
	sleep 1
	rmmod ecm 2>/dev/null || return 1
}

# Older builds attached ppepfifo to the physical WAN unconditionally. On a
# disconnected port its stats worker loops once per second with an empty list,
# floods the kernel log and can leave packet drops behind. Remove only a qdisc
# previously owned by this service; user-created QoS on other ports is left
# untouched.
cleanup_stale_ppe_qdisc() {
	local old_physical dev
	old_physical="$(sed -n 's/^wan_physical=//p' "$state" 2>/dev/null | tail -n 1)"
	for dev in "$old_physical" "$wan_physical"; do
		[ -n "$dev" ] || continue
		case "$dev" in *[!A-Za-z0-9_.:-]*) continue;; esac
		[ -d "/sys/class/net/$dev" ] || continue
		if tc qdisc show dev "$dev" 2>/dev/null | grep -q '^qdisc ppe'; then
			tc qdisc del dev "$dev" root >/dev/null 2>&1 || true
			log "removed stale PPE root qdisc from $dev"
		fi
	done
}

read_wan_status() {
	local status
	status="$(ubus call network.interface.wan status 2>/dev/null)" || return 1
	[ "$(printf '%s' "$status" | jsonfilter -e '@.up' 2>/dev/null)" = true ] || return 1
	wan_proto="$(printf '%s' "$status" | jsonfilter -e '@.proto' 2>/dev/null)"
	wan_l3="$(printf '%s' "$status" | jsonfilter -e '@.l3_device' 2>/dev/null)"
	wan_device="$(printf '%s' "$status" | jsonfilter -e '@.device' 2>/dev/null)"
	[ -n "$wan_device" ] || wan_device="$wan_l3"
	[ -n "$wan_device" ]
}

# Walk Linux lower-device links until a real hardware-facing netdev is found.
# A direct PPPoE/DHCP/static WAN therefore resolves straight to ethX, while a
# tagged PPPoE WAN naturally resolves pppoe-wan -> ethX.VID -> ethX.
resolve_wan_physical() {
	local dev="$wan_device" next link loops=0
	wan_layers="$wan_l3"
	[ "$wan_device" = "$wan_l3" ] || wan_layers="$wan_layers>$wan_device"
	wan_vlan=no
	while [ "$loops" -lt 8 ]; do
		loops=$((loops + 1))
		next=''
		for link in /sys/class/net/"$dev"/lower_*; do
			[ -e "$link" ] || continue
			next="${link##*/lower_}"
			break
		done
		if [ -z "$next" ]; then
			case "$dev" in
				*.*)
				next="${dev%%.*}"
				ip link show dev "$next" >/dev/null 2>&1 || next=''
				;;
			esac
		fi
		[ -n "$next" ] || break
		case "$dev" in *.*) wan_vlan=yes;; esac
		wan_layers="$wan_layers>$next"
		dev="$next"
	done
	wan_physical="$dev"
	case "$wan_device" in *.*) wan_vlan=yes;; esac
	ip link show dev "$wan_physical" >/dev/null 2>&1
}

ppe_map_dump() {
	local major
	[ -r "$map_major" ] || return 1
	major="$(cat "$map_major" 2>/dev/null)"
	case "$major" in ''|*[!0-9]*) return 1;; esac
	rm -f "$map_node"
	mknod "$map_node" c "$major" 0 2>/dev/null || return 1
	chmod 600 "$map_node"
	cat "$map_node" 2>/dev/null
	rm -f "$map_node"
}

ppe_map_has() {
	local wanted="$1"
	ppe_map_dump | grep -Fq ".netdev_name=$wanted"
}

wait_for_wan() {
	local count=0
	while [ "$count" -lt 30 ]; do
		read_wan_status && return 0
		count=$((count + 1))
		sleep 1
	done
	return 1
}

reconnect_pppoe() {
	[ "$wan_proto" = pppoe ] || return 0
	log "recreating PPPoE interface with noqueue for PPE acceleration"
	touch /tmp/be6500-accel-reconnecting
	ifdown wan >/dev/null 2>&1 || true
	sleep 1
	ifup wan >/dev/null 2>&1 || true
	if wait_for_wan; then
		rm -f /tmp/be6500-accel-reconnecting
		return 0
	fi
	rm -f /tmp/be6500-accel-reconnecting
	return 1
}

fallback_flowtable() {
	local reason="$1"
	stop_ecm || true
	cleanup_stale_ppe_qdisc
	set_fw4_offload 1
	reload_fw4_if_changed
	write_state flowtable "$reason"
	log "PPE/ECM unavailable ($reason); using fw4 flowtable fallback"
	exit 0
}

# PPP netdevices must be created with noqueue. fq_codel on pppoe-wan is
# rejected by the PPE front end even when every logical interface is mapped.
sysctl -q -w net.core.default_qdisc=noqueue >/dev/null 2>&1 || true

for module in qca_nss_ppe_vlan qca_nss_ppe_bridge_mgr \
	qca_nss_ppe_pppoe_mgr; do
	modprobe "$module" >/dev/null 2>&1 || fallback_flowtable "module-$module"
done

if ! wait_for_wan; then
	cleanup_stale_ppe_qdisc
	write_state waiting 'wan-down'
	log 'WAN is not up yet; interface hotplug will retry PPE acceleration'
	exit 0
fi
resolve_wan_physical || fallback_flowtable 'wan-physical-not-found'

# Existing PPP interfaces from an upgrade may still carry fq_codel, or may
# predate the PPPoE manager. Recreate only that logical WAN once; changing a
# direct DHCP/static WAN never causes a reconnect here.
if [ "$wan_proto" = pppoe ]; then
	if ! tc qdisc show dev "$wan_l3" 2>/dev/null | grep -q '^qdisc noqueue' || \
	   ! ppe_map_has "$wan_l3"; then
		reconnect_pppoe || fallback_flowtable 'pppoe-reconnect-failed'
		resolve_wan_physical || fallback_flowtable 'wan-physical-after-reconnect'
	fi
	if ! tc qdisc show dev "$wan_l3" 2>/dev/null | grep -q '^qdisc noqueue'; then
		fallback_flowtable 'pppoe-qdisc-not-noqueue'
	fi
	ppe_map_has "$wan_l3" || fallback_flowtable 'pppoe-not-mapped'
fi

cleanup_stale_ppe_qdisc

# nft flowtables and ECM must not compete for the same direct connection.
# Proxy/firewall policy still runs first; only connections left on the normal
# forwarding path are candidates for ECM/PPE acceleration.
set_fw4_offload 0
reload_fw4_if_changed

if [ ! -d /sys/module/ecm ]; then
	# OpenWrt's minimal modprobe does not forward module arguments. Loading the
	# object directly is required; AUTO cannot select a front end in this
	# PPE-only ECM build and otherwise resolves to ECM_FRONT_END_TYPE_MAX.
	insmod "/lib/modules/$(uname -r)/ecm.ko" front_end_selection=3 \
		register_ip_post_routing=1 register_br_post_routing=1 \
		>/dev/null 2>&1 || \
		fallback_flowtable 'ecm-load-failed'
fi

[ -d /sys/kernel/debug/ecm/ecm_ppe_ipv4 ] || fallback_flowtable 'ecm-ppe-frontend-missing'
write_state ppe-ecm ''
log "PPE/ECM enabled: $wan_layers (physical $wan_physical, vlan $wan_vlan)"
exit 0
