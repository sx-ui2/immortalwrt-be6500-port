#!/bin/sh

# JDCOS-compatible client and guest shaping.
#
# The factory firmware does not mix PPE forwarding with per-client policing.
# If at least one client/guest limit is configured it switches ECM to SFE and
# applies HTB classes to the WAN uplink and the LAN/guest downlink. With no
# configured limits the qdiscs are removed and ECM returns to AUTO (PPE).

CONFIG=device_manager
STATE=/tmp/be6500-qos.devices
OK=/tmp/be6500-guest-qos.ok
RULES=/tmp/be6500-qos.rules.$$
MODE_RULES=/tmp/be6500-qos.mode.rules.$$
MODE_STATE=/tmp/be6500-qos.mode
LOCK=/var/run/be6500-qos.lock
MAX_RATE=10000mbit

mkdir "$LOCK" 2>/dev/null || exit 0
trap 'rm -f "$RULES" "$MODE_RULES"; rmdir "$LOCK" 2>/dev/null' EXIT INT TERM
rm -f "$OK"

is_uint() {
	case "$1" in ''|*[!0-9]*) return 1;; *) return 0;; esac
}

mbit_to_kbit() {
	awk -v value="$1" 'BEGIN {
		if (value !~ /^[0-9]+([.][0-9]+)?$/ || value < 0) exit 1
		printf "%.0f", value * 1000
	}'
}

wan_device() {
	local dev
	dev="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.l3_device' 2>/dev/null)"
	[ -n "$dev" ] || dev="$(ubus call network.interface.wan status 2>/dev/null | jsonfilter -e '@.device' 2>/dev/null)"
	[ -n "$dev" ] || dev="$(uci -q get network.wan.device)"
	printf '%s\n' "$dev"
}

bridge_for_v4() {
	local dev
	dev="$(ip -4 route get "$1" 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p' | head -n1)"
	case "$dev" in br-guest) echo br-guest;; *) echo br-lan;; esac
}

cleanup_qdiscs() {
	[ -r "$STATE" ] || return 0
	while IFS= read -r dev; do
		[ -n "$dev" ] || continue
		tc qdisc del dev "$dev" root handle 1: >/dev/null 2>&1 || true
	done < "$STATE"
	rm -f "$STATE"
}

set_engine() {
	local wanted="$1" current
	current="$(uci -q get ecm.global.acceleration_engine)"
	[ "${current:-auto}" = "$wanted" ] && return 0
	uci -q set ecm.global.acceleration_engine="$wanted" || return 1
	uci -q commit ecm || return 1
	/etc/init.d/qca-nss-ecm reload >/dev/null 2>&1 || {
		logger -t be6500-qos "ECM failed to switch from ${current:-auto} to $wanted"
		return 1
	}
	logger -t be6500-qos "ECM acceleration engine switched to $wanted"
}

defunct_ip() {
	local ip="$1" path version any
	case "$ip" in *:*) version=6; any='::';; *) version=4; any='0.0.0.0';; esac
	for path in /proc/sys/net/ecm/defunct_by_5tuple_mask /sys/kernel/debug/ecm/defunct_by_5tuple_mask; do
		[ -w "$path" ] || continue
		printf 'ip_ver=%s sip=%s sport=0 dip=%s dport=0 protocol=0\n' "$version" "$ip" "$any" > "$path" 2>/dev/null || true
		printf 'ip_ver=%s sip=%s sport=0 dip=%s dport=0 protocol=0\n' "$version" "$any" "$ip" > "$path" 2>/dev/null || true
	done
}

defunct_all() {
	local path
	for path in /proc/sys/net/ecm/ecm_db/defunct_all /sys/kernel/debug/ecm/ecm_db/defunct_all; do
		[ -w "$path" ] || continue
		echo 1 > "$path" 2>/dev/null || true
	done
}

apply_traffic_mode() {
	local mode previous
	mode="$(uci -q get be6500_oem.qos.mode)"
	case "$mode" in 0|1|2) ;; *) mode=1;; esac
	previous="$(cat "$MODE_STATE" 2>/dev/null)"

	# Reproduce the three factory smartqos modes without installing the old
	# global HTB qdisc, which would force all traffic out of PPE.  The factory
	# classes are retained as skb priorities (1:300/400/200) and mirrored to
	# DSCP so ECM/PPE can preserve them after acceleration:
	#   0 - DNS/ICMP only (factory MODE_DOWN)
	#   1 - class 801 high + class 255 low (factory MODE_DEFAULT)
	#   2 - class 255 low (factory MODE_WEB)
	# The factory LOCAL_RQ rule only marks local TCP/2002 connections as 801.
	# No generic web/game port list is invented here.
	nft list table inet be6500_traffic_mode >/dev/null 2>&1 || \
		nft add table inet be6500_traffic_mode >/dev/null 2>&1 || return 1
	cat > "$MODE_RULES" <<'EOF'
flush table inet be6500_traffic_mode
table inet be6500_traffic_mode {
	chain forward {
		type filter hook forward priority mangle; policy accept;
EOF
	case "$mode" in
		1)
			cat >> "$MODE_RULES" <<'EOF'
		meta nfproto ipv4 ct mark 801 ip dscp set cs6 meta priority set 1:300
		meta nfproto ipv6 ct mark 801 ip6 dscp set cs6 meta priority set 1:300
		meta nfproto ipv4 meta mark 255 ip dscp set cs1 meta priority set 1:200
		meta nfproto ipv6 meta mark 255 ip6 dscp set cs1 meta priority set 1:200
EOF
			;;
		2)
			cat >> "$MODE_RULES" <<'EOF'
		meta nfproto ipv4 meta mark 255 ip dscp set cs1 meta priority set 1:200
		meta nfproto ipv6 meta mark 255 ip6 dscp set cs1 meta priority set 1:200
EOF
			;;
	esac
	cat >> "$MODE_RULES" <<'EOF'
		meta nfproto ipv4 udp dport 53 ip dscp set cs5 meta priority set 1:400
		meta nfproto ipv6 udp dport 53 ip6 dscp set cs5 meta priority set 1:400
		meta nfproto ipv4 ip protocol icmp ip dscp set cs5 meta priority set 1:400
		meta nfproto ipv6 ip6 nexthdr ipv6-icmp ip6 dscp set cs5 meta priority set 1:400
	}
	chain output {
		type route hook output priority mangle; policy accept;
EOF
	case "$mode" in
		1)
			cat >> "$MODE_RULES" <<'EOF'
		tcp dport 2002 ct mark set 801
		meta nfproto ipv4 ct mark 801 ip dscp set cs6 meta priority set 1:300
		meta nfproto ipv6 ct mark 801 ip6 dscp set cs6 meta priority set 1:300
		meta nfproto ipv4 meta mark 255 ip dscp set cs1 meta priority set 1:200
		meta nfproto ipv6 meta mark 255 ip6 dscp set cs1 meta priority set 1:200
EOF
			;;
		2)
			cat >> "$MODE_RULES" <<'EOF'
		meta nfproto ipv4 meta mark 255 ip dscp set cs1 meta priority set 1:200
		meta nfproto ipv6 meta mark 255 ip6 dscp set cs1 meta priority set 1:200
EOF
			;;
	esac
	cat >> "$MODE_RULES" <<'EOF'
		meta nfproto ipv4 udp dport 53 ip dscp set cs5 meta priority set 1:400
		meta nfproto ipv6 udp dport 53 ip6 dscp set cs5 meta priority set 1:400
		meta nfproto ipv4 ip protocol icmp ip dscp set cs5 meta priority set 1:400
		meta nfproto ipv6 ip6 nexthdr ipv6-icmp ip6 dscp set cs5 meta priority set 1:400
	}
}
EOF
	nft -c -f "$MODE_RULES" >/dev/null 2>&1 || return 1
	nft -f "$MODE_RULES" >/dev/null 2>&1 || return 1
	printf '%s\n' "$mode" > "$MODE_STATE"
	if [ "$mode" != "$previous" ]; then
		defunct_all
		logger -t be6500-qos "traffic priority mode switched to $mode without restarting Wi-Fi"
	fi
}

add_rule() {
	# IP, downlink device, download kbit/s, upload kbit/s
	local ip="$1" dev="$2" down="$3" up="$4"
	[ -n "$ip" ] && [ -n "$dev" ] || return 0
	grep -Fqx "$ip$(printf '\t')$dev$(printf '\t')$down$(printf '\t')$up" "$RULES" 2>/dev/null || \
		printf '%s\t%s\t%s\t%s\n' "$ip" "$dev" "$down" "$up" >> "$RULES"
}

explicit_macs=''
configured=0
: > "$RULES"

apply_traffic_mode || {
	echo '流量优先级规则应用失败' >&2
	exit 1
}

for section in $(uci show "$CONFIG" 2>/dev/null | sed -n "s/^$CONFIG\.\([^.=]*\)=limit$/\1/p"); do
	mac="$(uci -q get "$CONFIG.$section.mac" | tr 'a-f' 'A-F')"
	down="$(uci -q get "$CONFIG.$section.down")"
	up="$(uci -q get "$CONFIG.$section.up")"
	is_uint "$down" || down=0
	is_uint "$up" || up=0
	[ "$down" -gt 0 ] || [ "$up" -gt 0 ] || continue
	configured=1
	explicit_macs="$explicit_macs $mac"

	ipv4="$(awk -v m="$mac" 'toupper($2)==m { print $3; exit }' /tmp/dhcp.leases 2>/dev/null)"
	[ -z "$ipv4" ] || add_rule "$ipv4" "$(bridge_for_v4 "$ipv4")" "$down" "$up"

	ip -6 neigh show 2>/dev/null | awk -v m="$mac" \
		'toupper($0) ~ m && $1 !~ /^(fe80:|ff)/ { print $1 "\t" $3 }' | sort -u | \
	while IFS="$(printf '\t')" read -r ipv6 dev; do
		case "$dev" in br-guest) ;; *) dev=br-lan;; esac
		add_rule "$ipv6" "$dev" "$down" "$up"
	done
done

guest_enabled="$(uci -q get be6500_oem.guest_qos.enabled)"
guest_up="$(mbit_to_kbit "$(uci -q get be6500_oem.guest_qos.upload)" 2>/dev/null)" || guest_up=0
guest_down="$(mbit_to_kbit "$(uci -q get be6500_oem.guest_qos.download)" 2>/dev/null)" || guest_down=0
if [ "$guest_enabled" = 1 ] && { [ "$guest_down" -gt 0 ] || [ "$guest_up" -gt 0 ]; }; then
	configured=1
	while read -r _ mac ip _; do
		[ -n "$ip" ] || continue
		[ "$(bridge_for_v4 "$ip")" = br-guest ] || continue
		mac="$(printf '%s' "$mac" | tr 'a-f' 'A-F')"
		case " $explicit_macs " in *" $mac "*) continue;; esac
		add_rule "$ip" br-guest "$guest_down" "$guest_up"
	done < /tmp/dhcp.leases

	# DHCPv6 leases are not always present. Use the neighbour table for active
	# guest clients and keep the factory rule that an explicit client limit wins.
	ip -6 neigh show dev br-guest 2>/dev/null | awk '$1 !~ /^(fe80:|ff)/ && $5 != "" { print $1 "\t" toupper($5) }' | \
	while IFS="$(printf '\t')" read -r ipv6 mac; do
		case " $explicit_macs " in *" $mac "*) continue;; esac
		add_rule "$ipv6" br-guest "$guest_down" "$guest_up"
	done
fi

# Remove only qdiscs previously installed by this service. This also clears
# stale shaping from an old WAN device after PPPoE reconnects.
cleanup_qdiscs

if [ "$configured" = 0 ]; then
	set_engine auto || exit 1
	touch "$OK"
	exit 0
fi

set_engine sfe || exit 1

wan="$(wan_device)"
[ -n "$wan" ] || {
	echo 'WAN 接口尚未就绪，限速规则将在联网后自动重试' >&2
	exit 1
}

setup_root() {
	local dev="$1"
	ip link show "$dev" >/dev/null 2>&1 || return 1
	tc qdisc replace dev "$dev" root handle 1: htb default 1 >/dev/null 2>&1 || return 1
	grep -Fqx "$dev" "$STATE" 2>/dev/null || printf '%s\n' "$dev" >> "$STATE"
	tc class replace dev "$dev" parent 1: classid 1:1 htb rate "$MAX_RATE" ceil "$MAX_RATE" \
		burst 1m cburst 1m quantum 60000 >/dev/null 2>&1 || return 1
}

next_class=10
ensure_device() {
	local dev="$1"
	grep -Fqx "$dev" "$STATE" 2>/dev/null && return 0
	setup_root "$dev"
}

install_class() {
	local dev="$1" ip="$2" direction="$3" rate="$4" proto match class
	[ "$rate" -gt 0 ] || return 0
	ensure_device "$dev" || return 1
	class="$next_class"
	next_class=$((next_class + 1))
	tc class add dev "$dev" parent 1:1 classid "1:$class" htb \
		rate "${rate}kbit" ceil "${rate}kbit" burst 64k cburst 64k quantum 1514 >/dev/null 2>&1 || return 1
	case "$ip" in
		*:*) proto=ipv6; match="match ip6 $direction $ip/128";;
		*) proto=ip; match="match ip $direction $ip/32";;
	esac
	# Word splitting of $match is intentional: tc's u32 parser requires each
	# selector as a separate argument.
	# shellcheck disable=SC2086
	tc filter add dev "$dev" parent 1: protocol "$proto" pref "$class" u32 \
		$match flowid "1:$class" >/dev/null 2>&1 || return 1
}

while IFS="$(printf '\t')" read -r ip down_dev down up; do
	[ -n "$ip" ] || continue
	install_class "$down_dev" "$ip" dst "$down" || {
		echo "无法为 $ip 安装下载限速" >&2
		cleanup_qdiscs
		exit 1
	}
	install_class "$wan" "$ip" src "$up" || {
		echo "无法为 $ip 安装上传限速" >&2
		cleanup_qdiscs
		exit 1
	}
	defunct_ip "$ip"
done < "$RULES"

touch "$OK"
logger -t be6500-qos "factory-style SFE/HTB QoS applied on ${wan}"
exit 0
