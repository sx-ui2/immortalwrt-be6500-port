#!/bin/sh

# A sysupgrade may preserve a stale profile from an image built for the other
# QCN9224 personality.  Synchronize it before LuCI decides which channels to
# show.  The same helper runs before netifd on every subsequent boot.
[ "${BE6500_SKIP_WIFI_PERSONALITY_SYNC:-0}" = 1 ] ||
	/usr/libexec/be6500-sync-wifi-personality || exit 1

view="${BE6500_LUCI_WIRELESS_VIEW:-/www/luci-static/resources/view/network/wireless.js}"
[ -f "$view" ] || exit 0

# Width is a user-selectable radio setting.  Earlier development images hid
# the control to avoid invalid 149+160 MHz combinations; restore it here.  The
# OEM page and Wi-Fi mode helper already constrain 160 MHz to channels whose
# complete chandef is supported, so hiding every width was unnecessary.
if grep -q 'be6500-width-fixed' "$view"; then
	sed -i "s/E('label',{'class':'be6500-width-fixed','style':'[^']*'},\[_('Width')/E('label',{'style':'float:left; margin-right:3px'},[\/\*be6500-width-selectable\*\/_('Width')/" "$view"
elif ! grep -q 'be6500-width-selectable' "$view"; then
	sed -i "s/E('label',{'style':'float:left; margin-right:3px'},\[_('Width')/E('label',{'style':'float:left; margin-right:3px'},[\/\*be6500-width-selectable\*\/_('Width')/" "$view"
fi

# The QCN9224 split firmware reports a shared regulatory list for both pdevs.
# LuCI must additionally apply the board RF-path limits in tri-band mode. In
# dual-band/single-radio mode no 5 GHz entries are removed: iwinfo's complete
# regulatory list (36-165 where permitted by the selected country) is shown.

# netifd keeps a 160 MHz 5 GHz radio pending while hostapd performs the DFS
# channel-availability check.  LuCI otherwise reports this healthy transition
# as a generic inactive device, which makes it look like the radio failed.
if ! grep -q 'be6500DfsCac' "$view"; then
	sed -i "s#_('Device is not active')#(\/\*be6500DfsCac\*\/radioDev.ubus('dev','pending')\&\&radioDev.get('band')==='5g'\&\&\/160\$\/.test(String(radioDev.get('htmode')||''))?'DFS 信道检测中（约 60 秒）':_('Device is not active'))#" "$view"
fi

# netifd exposes one shared MLD through every participating wifi-device.  The
# stock LuCI overview consequently repeats the same logical AP/BSSID below all
# three MLO links and copies one link's channel, frequency and bitrate into
# every radio header.  Keep the physical radio rows (so their configuration
# remains reachable), but show each active logical BSSID only once.  For an MLO
# radio, do not claim that one link's live frequency is the state of all links.
if ! grep -q 'be6500MloOverview' "$view"; then
	sed -i "s#s.cfgsections=function(){const rv=\[\];#s.cfgsections=function(){const rv=[],be6500MloOverview=String(uci.get('wireless','main','mlo'))==='1',be6500SeenLogical={},be6500MloKey=function(wifi){const bssid=String(wifi.getActiveBSSID()||'').toUpperCase(),role=uci.get('wireless',wifi.getName(),'be6500_role');return role==='main'?'main:'+String(wifi.getSSID()||''):(bssid\&\&bssid!='00:00:00:00:00:00'?'bssid:'+bssid:wifi.getName());};#" "$view"
fi
if ! grep -q 'be6500MloLogicalRow' "$view"; then
	sed -i "s#if(wifi.getWifiDeviceName()==radio.getName())#if(\/\*be6500MloLogicalRow\*\/wifi.getWifiDeviceName()==radio.getName()\&\&(!be6500MloOverview||!be6500SeenLogical[be6500MloKey(wifi)]\&\&(be6500SeenLogical[be6500MloKey(wifi)]=true)))#" "$view"
fi
# Upgrade v70's intentionally hidden aggregate value to a truthful per-radio
# configured channel and frequency.  Fixed channels are the actual channels
# passed to hostapd; for ACS, saying "automatic" is more accurate than copying
# the shared MLD's first link onto all radios.
if grep -q 'be6500MloRadioStatus' "$view" && ! grep -q 'be6500MloRadioFrequency' "$view"; then
	sed -i "s#]);if(String(uci.get('wireless','main','mlo'))==='1'){dom.content(node,\[E('big',{},E('strong',{},name+' · MLO')),E('div',{},/\*be6500MloRadioStatus\*/'多链路状态由驱动统一管理')\]);return node;}let channel,frequency,bitrate;#]);let channel,frequency,bitrate;if(String(uci.get('wireless','main','mlo'))==='1'){const be6500Channel=parseInt(radioDev.get('channel'),10),be6500Band=String(radioDev.get('band')||''),be6500Frequency=be6500Channel>0?(be6500Band==='2g'?(be6500Channel===14?2.484:(2407+be6500Channel*5)\/1000):(5000+be6500Channel*5)\/1000):0;L.itemlist(node.lastElementChild,[_('Channel'),be6500Channel>0?'%d (%.3f %s)'.format(be6500Channel,be6500Frequency,_('GHz')):'自动',_('Bitrate'),/\*be6500MloRadioFrequency\*/'MLO'],' | ');return node;}#" "$view"
fi
if ! grep -q 'be6500MloRadioFrequency' "$view"; then
	sed -i "s#]);let channel,frequency,bitrate;#]);let channel,frequency,bitrate;if(String(uci.get('wireless','main','mlo'))==='1'){const be6500Channel=parseInt(radioDev.get('channel'),10),be6500Band=String(radioDev.get('band')||''),be6500Frequency=be6500Channel>0?(be6500Band==='2g'?(be6500Channel===14?2.484:(2407+be6500Channel*5)\/1000):(5000+be6500Channel*5)\/1000):0;L.itemlist(node.lastElementChild,[_('Channel'),be6500Channel>0?'%d (%.3f %s)'.format(be6500Channel,be6500Frequency,_('GHz')):'自动',_('Bitrate'),/\*be6500MloRadioFrequency\*/'MLO'],' | ');return node;}#" "$view"
fi

if grep -q 'be6500SplitMode' "$view"; then
	# Upgrade the first split-range hotfix (which started the high path at 149).
	sed -i "s/section_id==='radio2'\&\&freq.channel<149/section_id==='radio2'\&\&freq.channel<100/" "$view"
else
sed -i "s/freqlist\.forEach(freq=>{if(!freq\.band)/const be6500SplitMode=String(uci.get('wireless','main','freq_mode'))==='1';freqlist.forEach(freq=>{if(be6500SplitMode\&\&freq.band==5\&\&section_id==='radio1'\&\&freq.channel>64)return;if(be6500SplitMode\&\&freq.band==5\&\&section_id==='radio2'\&\&freq.channel<100)return;if(!freq.band)/" "$view"
fi

# All three RF paths have a fixed band on this board. Keep the hidden select
# in the form so LuCI can preserve its value, but do not offer an invalid band
# switch in the radio editor.
if ! grep -q 'be6500-band-fixed' "$view"; then
	sed -i "s/E('label',{'style':'float:left; margin-right:3px'},\[_('Band')/E('label',{'class':'be6500-band-fixed','style':'position:absolute;visibility:hidden;width:0;height:0;overflow:hidden'},[_('Band')/" "$view"
else
	sed -i -e "s/'class':'be6500-band-fixed','style':'display:none!important'/'class':'be6500-band-fixed','style':'position:absolute;visibility:hidden;width:0;height:0;overflow:hidden'/" \
		-e "s/'class':'be6500-band-fixed','style':'display:none'/'class':'be6500-band-fixed','style':'position:absolute;visibility:hidden;width:0;height:0;overflow:hidden'/" "$view"
fi

# A 160 MHz 5 GHz AP can include DFS channels even when its primary channel is
# 36.  CAC normally takes about 60 seconds.  The BE6500 serializes radio setup
# because all pdevs share one QSDK wiphy, so both the AP-ready wait and the next
# radio's lock wait must exceed CAC or netifd tears the AP down prematurely.
wifi_script="${BE6500_NETIFD_WIFI_SCRIPT:-/lib/netifd/wireless/mac80211.sh}"
if [ -f "$wifi_script" ]; then
	sed -i \
		-e 's/\[ "$be6500_radio_wait" -lt 45 \]/[ "$be6500_radio_wait" -lt 300 ]/' \
		-e 's/\[ "$be6500_radio_wait" -lt 120 \]/[ "$be6500_radio_wait" -lt 300 ]/' \
		-e 's/\[ "$be6500_ap_wait" -lt 45 \]/[ "$be6500_ap_wait" -lt 180 ]/' \
		-e 's/\[ "$be6500_ap_wait" -lt 120 \]/[ "$be6500_ap_wait" -lt 180 ]/' \
		"$wifi_script"
fi

# iwinfo exposes the shared QCN92xx frequency capabilities on every logical
# radio. Channel Analysis must follow each UCI wifi-device's configured band,
# otherwise it incorrectly creates 2.4 GHz and 5 GHz tabs for every radio.
channel_view="${BE6500_LUCI_CHANNEL_VIEW:-/www/luci-static/resources/view/status/channel_analysis.js}"
if [ -f "$channel_view" ] && ! grep -q 'be6500ConfiguredBand' "$channel_view"; then
	sed -i "s/for(var band in bands){if(bands\[band\]\.channels\.length==0)/for(var band in bands){var be6500ConfiguredBand=wifiDevs[ifname].dev.get('band'),be6500Disabled=String(wifiDevs[ifname].dev.get('disabled'))==='1';if(be6500Disabled||(be6500ConfiguredBand==='2g'\&\&band!=2)||(be6500ConfiguredBand==='5g'\&\&band!=5))continue;if(bands[band].channels.length==0)/" "$channel_view"
fi

# The status overview uses a second LuCI renderer.  It has the same shared-MLD
# problem as the network page: getChannel()/getFrequency() return one aggregate
# link for every radio.  For MLO, format each physical radio from its own UCI
# band/channel.  Keep ACS as "automatic" instead of inventing a frequency, and
# de-duplicate the logical main MLD while preserving distinct guest BSSIDs.
status_view="${BE6500_LUCI_WIFI_STATUS_VIEW:-/www/luci-static/resources/view/status/include/60_wifi.js}"
if [ -f "$status_view" ]; then
	if ! grep -q 'be6500MloStatusFrequency' "$status_view"; then
		# Inject next to renderbox's return statement instead of next to the
		# bitrate assignment.  The former is stable in both LuCI's formatted
		# feed source and the minified file installed in the image.
		sed -i "s#return E('div', { class: 'ifacebox' }, \[#var be6500MloStatus=String(uci.get('wireless','main','mlo'))==='1',be6500ConfiguredChannel=parseInt(radio.get('channel'),10),be6500ConfiguredBand=String(radio.get('band')||''),be6500ConfiguredFrequency=be6500ConfiguredChannel>0?(be6500ConfiguredBand==='2g'?(be6500ConfiguredChannel===14?2.484:(2407+be6500ConfiguredChannel*5)\/1000):(5000+be6500ConfiguredChannel*5)\/1000):0,be6500ChannelText=null;if(be6500MloStatus){be6500ChannelText=be6500ConfiguredChannel>0?'%d (%.3f %s)'.format(be6500ConfiguredChannel,be6500ConfiguredFrequency,_('GHz')):'自动';rate=null;}\/\*be6500MloStatusFrequency\*\/return E('div', { class: 'ifacebox' }, [#" "$status_view"
		sed -i "s#return E('div',{class:'ifacebox'},\[#var be6500MloStatus=String(uci.get('wireless','main','mlo'))==='1',be6500ConfiguredChannel=parseInt(radio.get('channel'),10),be6500ConfiguredBand=String(radio.get('band')||''),be6500ConfiguredFrequency=be6500ConfiguredChannel>0?(be6500ConfiguredBand==='2g'?(be6500ConfiguredChannel===14?2.484:(2407+be6500ConfiguredChannel*5)\/1000):(5000+be6500ConfiguredChannel*5)\/1000):0,be6500ChannelText=null;if(be6500MloStatus){be6500ChannelText=be6500ConfiguredChannel>0?'%d (%.3f %s)'.format(be6500ConfiguredChannel,be6500ConfiguredFrequency,_('GHz')):'自动';rate=null;}\/\*be6500MloStatusFrequency\*\/return E('div',{class:'ifacebox'},[#" "$status_view"
		sed -i "s#_('Channel'), chan ? '%d (%.3f %s)'.format(chan, freq, _('GHz')) : '-'#_('Channel'), be6500ChannelText || (chan ? '%d (%.3f %s)'.format(chan, freq, _('GHz')) : '-')#" "$status_view"
		sed -i "s#_('Channel'),chan?'%d (%.3f %s)'.format(chan,freq,_('GHz')):'-'#_('Channel'),be6500ChannelText||(chan?'%d (%.3f %s)'.format(chan,freq,_('GHz')):'-')#" "$status_view"
	fi
	if ! grep -q 'be6500MloStatusLogicalRow' "$status_view"; then
		sed -i "s#table.appendChild(this.renderbox(radios\[i\],networks.filter(function(net){return net.getWifiDeviceName()==radios\[i\].getName()})));#table.appendChild(this.renderbox(radios[i],networks.filter(function(net){if(\/\*be6500MloStatusLogicalRow\*\/net.getWifiDeviceName()!=radios[i].getName())return false;if(String(uci.get('wireless','main','mlo'))!=='1')return true;var role=uci.get('wireless',net.sid,'be6500_role'),bssid=String(net.getActiveBSSID()||'').toUpperCase(),key=role==='main'?'main:'+String(net.getActiveSSID()||''):(bssid\&\&bssid!='00:00:00:00:00:00'?'bssid:'+bssid:net.sid);if(seen[key])return false;seen[key]=true;return true;})));#" "$status_view"
		sed -i "s#networks.filter(function(net) { return net.getWifiDeviceName() == radios\[i\].getName() })));#networks.filter(function(net) { if (\/\*be6500MloStatusLogicalRow\*\/net.getWifiDeviceName() != radios[i].getName()) return false; if (String(uci.get('wireless', 'main', 'mlo')) !== '1') return true; var role = uci.get('wireless', net.sid, 'be6500_role'), bssid = String(net.getActiveBSSID() || '').toUpperCase(), key = role === 'main' ? 'main:' + String(net.getActiveSSID() || '') : (bssid \&\& bssid != '00:00:00:00:00:00' ? 'bssid:' + bssid : net.sid); if (seen[key]) return false; seen[key] = true; return true; })));#" "$status_view"
	fi
	grep -q 'be6500MloStatusFrequency' "$status_view" &&
		grep -q 'be6500MloStatusLogicalRow' "$status_view" || exit 1
fi

# Change the loader URL whenever this board-specific view patch changes. This
# prevents a previously opened LuCI tab from reusing the unfiltered class file.
headers="${BE6500_LUCI_HEADERS:-/usr/share/ucode/luci/template/header.ut}"
for header in $headers; do
	[ ! -f "$header" ] || sed -i \
		-e 's#luci\.js?v=26\.236\.50592~9b8ee64-{{ pkgs_update_time }}#luci.js?v=26.236.50592~9b8ee64-be6500v23-{{ pkgs_update_time }}#' \
		-e 's#be6500v[0-9]*-{{ pkgs_update_time }}#be6500v23-{{ pkgs_update_time }}#' "$header"
done

grep -q 'be6500SplitMode' "$view" &&
	grep -q 'be6500-width-selectable' "$view" &&
	grep -q 'be6500MloOverview' "$view" &&
	grep -q 'be6500MloLogicalRow' "$view" &&
	grep -q 'be6500MloRadioFrequency' "$view" || exit 1

# LuCI's stock swconfig RPC only exposes link state and speed.  Export the
# QCA8386 per-port MIB byte counters as well so the overview does not show
# every LAN socket as 0 B.
rpcd_luci="${BE6500_RPCD_LUCI:-/usr/share/rpcd/ucode/luci}"
if [ -f "$rpcd_luci" ] && ! grep -q 'port.rx_bytes = +m\[1\]' "$rpcd_luci"; then
	sed -i '/^[[:space:]]*getSwconfigPortState:/,/^[[:space:]]*setPassword:/ {
		/^[[:space:]]*let m;[[:space:]]*$/a\
\	\	\	\	\	if ((m = match(line, /RxGoodByte[ \\t]*:[ \\t]*([0-9]+)/)) != null)\
\	\	\	\	\	\	port.rx_bytes = +m[1];\
\
\	\	\	\	\	if ((m = match(line, /TxByte[ \\t]*:[ \\t]*([0-9]+)/)) != null)\
\	\	\	\	\	\	port.tx_bytes = +m[1];
	}' "$rpcd_luci"
fi
