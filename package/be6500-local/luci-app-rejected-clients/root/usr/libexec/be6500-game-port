#!/bin/sh

# JDCOS game-port policy for the QCA8386 LAN switch. Physical LAN1/LAN3 are
# wired in reverse switch-port order, exactly as on the factory firmware.

LOCK=/var/run/be6500-game-port.lock

mkdir "$LOCK" 2>/dev/null || exit 0
trap 'rmdir "$LOCK" 2>/dev/null' EXIT INT TERM

command -v ssdk_sh >/dev/null 2>&1 || {
	logger -t be6500-game-port -p err "ssdk_sh is unavailable"
	exit 1
}
[ -w /sys/ssdk/dev_id ] || {
	logger -t be6500-game-port -p err "/sys/ssdk/dev_id is unavailable"
	exit 1
}

ssdk() {
	ssdk_sh "$@" >/dev/null 2>&1
}

select_switch() {
	printf '%s\n' "$1" > /sys/ssdk/dev_id
}

flush_game_port() {
	select_switch 1 || return 1
	for port in 0 1 2 3 4 5; do
		ssdk acl list unbind 1 0 0 "$port" || true
	done
	ssdk acl rule del 1 0 1 || true
	ssdk acl list destroy 1 || true

	select_switch 0 || return 1
	ssdk qos ptpriprece set 0 0 1 3 4 2 0 no no 0 0 || true
	for port in 1 2 3 4; do
		ssdk qos ptpriprece set "$port" 2 3 1 6 5 5 no no 4 4 || true
	done
	ssdk qos ptpriprece set 5 0 1 3 4 2 0 no no 0 0 || true
	ssdk qos dscpmap set 0 0xc0 0x0 0x0 0x0 0x0 0x0 0x0 no no no no no 0x0 || true
	ssdk servcode config set 1 no 0 0xfffefcff 0xffbfff 0 0 0 0 0 0 0 || true
}

apply_game_port() {
	logical="$(uci -q get be6500_oem.game.port)"
	case "$logical" in
		lan1) port=3 ;;
		lan2) port=2 ;;
		lan3) port=1 ;;
		*) logger -t be6500-game-port -p err "invalid logical port: $logical"; return 1 ;;
	esac

	select_switch 1 || return 1
	for current in 0 1 2 3; do
		ssdk qos ptmode set "$current" dscp enable || return 1
	done
	ssdk acl list create 1 0 || return 1
	ssdk acl rule add 1 0 1 no 0x0 0x0 mac no no no no no no no no no no no no no no no no no no no no no no no no no no no yes no no no no no yes 48 0x3f no yes 7 no no 0 0 no no no no no no no no no no no no no no no no no no no no 0 || return 1
	ssdk acl list bind 1 0 0 "$port" || return 1
	ssdk acl status set enable || return 1

	select_switch 0 || return 1
	ssdk qos ptpriprece set "$port" 2 6 1 5 4 4 no no 3 3 || return 1
	ssdk qos dscpmap set 0 0xc0 0x0 0x0 0x7 0x0 0x0 0x0 no no no yes no 0x0 || return 1
	ssdk servcode config set 1 no 0 0xfffefcff 0xfbbfff 0 0 0 0 0 0 0 || return 1
	logger -t be6500-game-port "enabled $logical (QCA8386 port $port)"
}

case "$1" in
	start)
		flush_game_port
		if [ "$(uci -q get be6500_oem.game.enable)" = "1" ]; then apply_game_port; fi
		;;
	stop)
		flush_game_port
		;;
	restart|reload)
		flush_game_port
		if [ "$(uci -q get be6500_oem.game.enable)" = "1" ]; then apply_game_port; fi
		;;
	*)
		echo "Usage: $0 {start|stop|restart|reload}" >&2
		exit 1
		;;
esac
