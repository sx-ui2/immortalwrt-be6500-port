#!/bin/sh

# Native dual-WAN policy routing for firewall4.  This intentionally does not
# invoke iptables: fw4 loads the generated nft fragment into table inet fw4.

NFT_FILE=/etc/nftables.d/30-be6500-multiwan.nft
LOCK_DIR=/var/lock/be6500-fw4-multiwan.lock.d
MARK1=0x101
MARK2=0x102
TABLE1=101
TABLE2=102

# Interface hotplug events can arrive while firewall reload is in progress.
# Never queue workers behind a blocking lock: the reload below itself can emit
# another hotplug event, so queued workers would otherwise grow without bound.
mkdir "$LOCK_DIR" 2>/dev/null || exit 0
trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT INT TERM

enabled="$(uci -q get device_manager.network.multidial)"
mode="$(uci -q get device_manager.network.multi_mode)"
[ -n "$mode" ] || mode=balanced

status_value() {
	ubus call "network.interface.$1" status 2>/dev/null | jsonfilter -e "@$2" 2>/dev/null
}

clear_policy() {
	policy_changed=0
	[ -e "$NFT_FILE" ] && policy_changed=1
	ip -4 rule del priority 1101 2>/dev/null || true
	ip -4 rule del priority 1102 2>/dev/null || true
	ip -4 route flush table "$TABLE1" 2>/dev/null || true
	ip -4 route flush table "$TABLE2" 2>/dev/null || true
	rm -f "$NFT_FILE"
}

reload_if_changed() {
	[ "$policy_changed" = 1 ] || return 0
	/etc/init.d/firewall reload >/dev/null 2>&1
}

copy_routes() {
	table="$1"
	dev="$2"
	ip -4 route show table main | while IFS= read -r route; do
		case "$route" in default*) continue;; esac
		ip -4 route add table "$table" $route 2>/dev/null || true
	done
	ip -4 route replace table "$table" default dev "$dev" 2>/dev/null
}

clear_policy
[ "$1" = clear ] && {
	reload_if_changed
	exit 0
}
[ "$enabled" = 1 ] || {
	reload_if_changed
	exit 0
}

dev1="$(status_value wan '.l3_device')"
dev2="$(status_value wan2 '.l3_device')"
up1="$(status_value wan '.up')"
up2="$(status_value wan2 '.up')"

# Backup mode is handled natively by netifd route metrics (WAN 10, WAN2 20).
# No packet marking is needed, so fw4 remains free of an extra chain.
[ "$mode" = balanced ] || {
	reload_if_changed
	exit 0
}

[ "$up1" = true ] && [ "$up2" = true ] && [ -n "$dev1" ] && [ -n "$dev2" ] || {
	reload_if_changed
	exit 0
}

copy_routes "$TABLE1" "$dev1"
copy_routes "$TABLE2" "$dev2"
ip -4 rule add priority 1101 fwmark "$MARK1" lookup "$TABLE1"
ip -4 rule add priority 1102 fwmark "$MARK2" lookup "$TABLE2"

NFT_NEW="${NFT_FILE}.new.$$"
cat >"$NFT_NEW" <<EOF
# Generated by be6500-fw4-multiwan; included inside table inet fw4.
chain be6500_multiwan_prerouting {
	type filter hook prerouting priority mangle - 5; policy accept;
	iifname "$dev1" ct state new ct mark set $MARK1
	iifname "$dev2" ct state new ct mark set $MARK2
	iifname "br-lan" ct state new ct mark 0 ct mark set numgen random mod 2 map { 0 : $MARK1, 1 : $MARK2 }
	ct mark != 0 meta mark set ct mark
}
EOF

if [ ! -e "$NFT_FILE" ] || ! cmp -s "$NFT_NEW" "$NFT_FILE"; then
	mv "$NFT_NEW" "$NFT_FILE"
	policy_changed=1
else
	rm -f "$NFT_NEW"
fi
reload_if_changed
logger -t be6500-multiwan "fw4 native balanced policy active: $dev1/$dev2"
