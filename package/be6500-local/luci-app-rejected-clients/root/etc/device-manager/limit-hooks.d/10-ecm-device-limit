#!/bin/sh

# Preserve PPE acceleration globally. Only configured per-device addresses are
# classified as non-accelerated so nftables can police their packets.

CONFIG=device_manager
RULE_NODE=/proc/sys/net/ecm_ae_select_test/rule
STATE=/tmp/device-manager-ecm-limit.rules
DEFUNCT=/proc/sys/net/ecm/defunct_by_5tuple_mask

[ -w "$RULE_NODE" ] || exit 0

if [ -f "$STATE" ]; then
	while IFS= read -r rule; do
		[ -n "$rule" ] || continue
		printf '0%s\n' "${rule#1}" > "$RULE_NODE" 2>/dev/null || true
	done < "$STATE"
fi
: > "$STATE"

defunct_v4() {
	[ -w "$DEFUNCT" ] || return 0
	printf 'ip_ver=4 sip=%s sport=0 dip=0.0.0.0 dport=0 protocol=0\n' "$1" > "$DEFUNCT" 2>/dev/null || true
	printf 'ip_ver=4 sip=0.0.0.0 sport=0 dip=%s dport=0 protocol=0\n' "$1" > "$DEFUNCT" 2>/dev/null || true
}

defunct_v6() {
	[ -w "$DEFUNCT" ] || return 0
	printf 'ip_ver=6 sip=%s sport=0 dip=:: dport=0 protocol=0\n' "$1" > "$DEFUNCT" 2>/dev/null || true
	printf 'ip_ver=6 sip=:: sport=0 dip=%s dport=0 protocol=0\n' "$1" > "$DEFUNCT" 2>/dev/null || true
}

add_rule() {
	printf '%s\n' "$1" > "$RULE_NODE" || return 1
	printf '%s\n' "$1" >> "$STATE"
}

for section in $(uci show "$CONFIG" 2>/dev/null | sed -n "s/^$CONFIG\.\([^.=]*\)=limit$/\1/p"); do
	mac="$(uci -q get "$CONFIG.$section.mac")"
	down="$(uci -q get "$CONFIG.$section.down")"
	up="$(uci -q get "$CONFIG.$section.up")"
	[ "${down:-0}" -gt 0 ] || [ "${up:-0}" -gt 0 ] || continue

	ipv4="$(awk -v m="$mac" 'toupper($2)==toupper(m){print $3;exit}' /tmp/dhcp.leases 2>/dev/null)"
	if [ -n "$ipv4" ]; then
		add_rule "1/0/$ipv4/0/0.0.0.0/0/5"
		add_rule "1/0/0.0.0.0/0/$ipv4/0/5"
		defunct_v4 "$ipv4"
	fi

	ip -6 neigh show 2>/dev/null | awk -v m="$mac" \
		'toupper($0) ~ toupper(m) && $1 !~ /^(fe80:|ff)/ {print $1}' | sort -u | \
	while IFS= read -r ipv6; do
		[ -n "$ipv6" ] || continue
		add_rule "1/0/$ipv6/0/::/0/5"
		add_rule "1/0/::/0/$ipv6/0/5"
		defunct_v6 "$ipv6"
	done
done

exit 0
