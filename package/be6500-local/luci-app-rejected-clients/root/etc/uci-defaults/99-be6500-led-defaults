#!/bin/sh

# Apply the requested LED profile once to configurations preserved across a
# sysupgrade. Fresh installations already contain this revision in the image.
[ "$(uci -q get be6500_oem.led.defaults_revision)" = '20260923-1' ] && exit 0

uci -q get be6500_oem.led >/dev/null 2>&1 || uci -q set be6500_oem.led=settings || exit 1
uci -q set be6500_oem.led.enabled='1' || exit 1
uci -q set be6500_oem.led.policy='custom' || exit 1
uci -q set be6500_oem.led.color='blue' || exit 1
uci -q set be6500_oem.led.effect='steady' || exit 1

while uci -q get 'be6500_oem.@led_rule[0]' >/dev/null 2>&1; do
	uci -q delete 'be6500_oem.@led_rule[0]' || exit 1
done

while read -r state color effect; do
	[ -n "$state" ] || continue
	section="$(uci -q add be6500_oem led_rule)" || exit 1
	uci -q set "be6500_oem.$section.state=$state" || exit 1
	uci -q set "be6500_oem.$section.color=$color" || exit 1
	uci -q set "be6500_oem.$section.effect=$effect" || exit 1
	uci -q set "be6500_oem.$section.enabled=1" || exit 1
done <<'RULES'
overheat red fast
booting red+green fast
upgrading green fast
wifi_off green+blue steady
plugin red+green steady
usb red+blue steady
offline red steady
online blue fast
RULES

uci -q set be6500_oem.led.defaults_revision='20260923-1' || exit 1
uci -q commit be6500_oem || exit 1
exit 0
