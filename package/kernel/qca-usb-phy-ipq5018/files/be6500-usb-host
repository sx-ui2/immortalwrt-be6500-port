#!/bin/sh

# The v42/v44 images loaded new PHY code in the boot-critical path and could
# leave the router unbootable. Keep the proven kernel Image, wait until normal
# services are up, and persist a one-shot guard before touching either PHY.

STATE_CONFIG="be6500_usb_guard.guard"
LOCK_DIR="/var/lock/be6500-usb-host.lock"

log() {
	logger -t be6500-usb-host -- "$*"
}

state_get() {
	uci -q get "$STATE_CONFIG.state" || printf '%s\n' new
}

state_set() {
	local state="$1"
	local error="${2:-}"

	uci -q batch <<-EOF
		set $STATE_CONFIG=guard
		set $STATE_CONFIG.state='$state'
		set $STATE_CONFIG.last_error='$error'
	EOF
	uci -q commit be6500_usb_guard
	sync
}

host_ready() {
	local host
	local platform

	for host in /sys/class/usb_host/host*; do
		[ -e "$host" ] || continue
		for platform in /sys/bus/platform/devices/*8a00000*; do
			[ -e "$platform" ] || continue
			[ -L "$platform/driver" ] && return 0
		done
	done

	return 1
}

load_phys() {
	modprobe phy-qcom-m31 || return 1
	modprobe phy-qca-uniphy || return 1
	modprobe dwc3-qcom || return 1
	modprobe xhci-plat-hcd || return 1

	return 0
}

probe_once() {
	local state
	local remaining=20

	state="$(state_get)"
	case "$state" in
		probing)
			state_set blocked "previous PHY probe did not complete"
			log "previous PHY probe was interrupted; automatic USB probing is blocked"
			return 1
			;;
		blocked)
			log "USB PHY probing is blocked after an earlier failed attempt"
			return 1
			;;
	esac

	state_set probing
	log "loading Linux 6.6 IPQ5332 M31 and UniPHY drivers"
	if ! load_phys; then
		state_set blocked "PHY or DWC3 module load failed"
		log "USB PHY module load failed; the next boot will remain on the safe path"
		return 1
	fi

	while [ "$remaining" -gt 0 ]; do
		if host_ready; then
			state_set ready
			log "IPQ5332 DWC3 host registered; USB hotplug is ready"
			return 0
		fi
		remaining=$((remaining - 1))
		sleep 1
	done

	state_set blocked "DWC3 host did not register within 20 seconds"
	log "DWC3 host did not register; automatic USB probing is blocked"
	return 1
}

run_locked() {
	mkdir -p /var/lock
	if ! mkdir "$LOCK_DIR" 2>/dev/null; then
		log "another USB PHY probe is already running"
		return 1
	fi
	trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT INT TERM
	probe_once
}

case "${1:-status}" in
	boot)
		[ "$(cat /tmp/sysinfo/board_name 2>/dev/null)" = "jdcloud,be6500" ] || exit 0
		sleep "${BE6500_USB_BOOT_DELAY:-45}"
		run_locked
		;;
	retry)
		state_set new
		run_locked
		;;
	status)
		printf 'state=%s\n' "$(state_get)"
		host_ready && printf '%s\n' 'host=ready' || printf '%s\n' 'host=not-ready'
		;;
	*)
		printf 'Usage: %s {status|retry|boot}\n' "$0" >&2
		exit 2
		;;
esac
