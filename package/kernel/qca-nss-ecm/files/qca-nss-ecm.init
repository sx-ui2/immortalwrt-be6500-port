#!/bin/sh /etc/rc.common

START=26
STOP=89

get_front_end_mode() {
	local engine
	engine="$(uci -q get ecm.global.acceleration_engine)"
	case "${engine:-auto}" in
		auto) echo 0 ;;
		sfe) echo 2 ;;
		ppe) echo 3 ;;
		ppe-sfe) echo 5 ;;
		*) logger -t qca-nss-ecm "invalid acceleration engine: $engine"; return 1 ;;
	esac
}

disable_flowtable() {
	local changed=0
	[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = 0 ] || {
		uci -q set firewall.@defaults[0].flow_offloading=0
		changed=1
	}
	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = 0 ] || {
		uci -q set firewall.@defaults[0].flow_offloading_hw=0
		changed=1
	}
	[ "$changed" = 0 ] || uci -q commit firewall
}

set_accel_tunables() {
	local engine path delay=0
	engine="$(uci -q get ecm.global.acceleration_engine)"
	[ "$engine" = sfe ] && delay=1

	# This is also present in the JDCOS 4.5.2 factory sysctl file.
	[ ! -w /proc/sys/net/netfilter/nf_conntrack_tcp_no_window_check ] || \
		echo 1 > /proc/sys/net/netfilter/nf_conntrack_tcp_no_window_check

	for path in \
		/proc/sys/net/ecm/ecm_classifier_default/accel_delay_pkts \
		/sys/kernel/debug/ecm/ecm_classifier_default/accel_delay_pkts; do
		[ -w "$path" ] && echo "$delay" > "$path"
	done
}

load_sfe() {
	[ -d /sys/module/qca_nss_sfe ] && return 0
	modprobe qca-nss-sfe >/dev/null 2>&1 || {
		logger -t qca-nss-ecm 'unable to load qca-nss-sfe'
		return 1
	}
}

load_dependencies() {
	local module
	for module in qca_nss_ppe_vlan qca_nss_ppe_bridge_mgr \
		qca_nss_ppe_pppoe_mgr; do
		modprobe "$module" >/dev/null 2>&1 || return 1
	done
	load_sfe
}

start() {
	local mode engine

	# ECM and nft flowtables must not own the same connection concurrently.
	disable_flowtable
	load_dependencies || return 1

	mode="$(get_front_end_mode)" || return 1
	engine="$(uci -q get ecm.global.acceleration_engine)"
	if [ ! -d /sys/module/ecm ]; then
		insmod "/lib/modules/$(uname -r)/ecm.ko" \
			front_end_selection="$mode" \
			register_ip_post_routing=1 register_br_post_routing=1 || return 1
	fi

	# The factory image only loads the L2 helper in explicit SFE mode.
	if [ "${engine:-auto}" = sfe ] && [ ! -d /sys/module/ecm_sfe_l2 ]; then
		modprobe ecm_sfe_l2 >/dev/null 2>&1 || true
	fi

	set_accel_tunables
	logger -t qca-nss-ecm "started with ${engine:-auto} front end (mode $mode)"
}

stop() {
	local path
	[ -d /sys/module/ecm ] || return 0

	for path in \
		/proc/sys/net/ecm/front_end_ipv4_stop \
		/sys/kernel/debug/ecm/front_end_ipv4_stop \
		/proc/sys/net/ecm/front_end_ipv6_stop \
		/sys/kernel/debug/ecm/front_end_ipv6_stop; do
		[ -w "$path" ] && echo 1 > "$path"
	done
	for path in \
		/proc/sys/net/ecm/ecm_db/defunct_all \
		/sys/kernel/debug/ecm/ecm_db/defunct_all; do
		[ -w "$path" ] && echo 1 > "$path"
	done
	sleep 1
	rmmod ecm_sfe_l2 2>/dev/null || true
	rmmod ecm 2>/dev/null || true
	rmmod qca_nss_sfe 2>/dev/null || true
}

reload() {
	stop
	start
}
