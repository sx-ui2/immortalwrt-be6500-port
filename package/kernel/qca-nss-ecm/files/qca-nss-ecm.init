#!/bin/sh /etc/rc.common

START=26
STOP=89

disable_flowtable() {
	local changed=0

	[ "$(uci -q get firewall.@defaults[0].flow_offloading)" = 0 ] || {
		uci -q set firewall.@defaults[0].flow_offloading=0
		changed=1
	}
	[ "$(uci -q get firewall.@defaults[0].flow_offloading_hw)" = 0 ] || {
		uci -q set firewall.@defaults[0].flow_offloading_hw=0
		changed=1
	}
	[ "$changed" = 0 ] || uci -q commit firewall
}

set_accel_delay() {
	local path

	for path in \
		/proc/sys/net/ecm/ecm_classifier_default/accel_delay_pkts \
		/sys/kernel/debug/ecm/ecm_classifier_default/accel_delay_pkts; do
		[ -w "$path" ] && echo 0 > "$path"
	done
}

start() {
	local module

	# ECM and nft flowtables are alternative connection fast paths. Keep fw4's
	# flowtable disabled and let the Qualcomm PPE front end own acceleration.
	disable_flowtable

	# The manager modules are normally autoloaded before this service. Loading
	# them again is harmless and also covers a manual package installation.
	for module in qca_nss_ppe_vlan qca_nss_ppe_bridge_mgr \
		qca_nss_ppe_pppoe_mgr; do
		modprobe "$module" >/dev/null 2>&1 || return 1
	done

	if [ ! -d /sys/module/ecm ]; then
		# This image deliberately builds only ECM's PPE front end. AUTO (0) is
		# valid in the vendor PPE+SFE build, but resolves to no front end here.
		insmod "/lib/modules/$(uname -r)/ecm.ko" front_end_selection=3 \
			register_ip_post_routing=1 register_br_post_routing=1 || return 1
	fi

	# Normal clients return DONT_CARE here and stay on PPE.  The device-limit
	# hook installs NONE rules only for individually limited addresses.
	if [ ! -d /sys/module/ecm_ae_select ]; then
		insmod "/lib/modules/$(uname -r)/ecm_ae_select.ko" || return 1
	fi
	[ ! -x /etc/device-manager/limit-hooks.d/10-ecm-device-limit ] || \
		/etc/device-manager/limit-hooks.d/10-ecm-device-limit

	set_accel_delay
}

stop() {
	[ -d /sys/module/ecm ] || return 0
	rmmod ecm_ae_select 2>/dev/null || true
	[ -w /proc/sys/net/ecm/front_end_ipv4_stop ] && echo 1 > /proc/sys/net/ecm/front_end_ipv4_stop
	[ -w /proc/sys/net/ecm/front_end_ipv6_stop ] && echo 1 > /proc/sys/net/ecm/front_end_ipv6_stop
	[ -w /proc/sys/net/ecm/ecm_db/defunct_all ] && echo 1 > /proc/sys/net/ecm/ecm_db/defunct_all
	sleep 1
	rmmod ecm 2>/dev/null || true
}

reload() {
	stop
	start
}
