+static bool ath12k_mac_be6500_auto_rf_path(struct ath12k *ar)
+{
+	return ar->ab->hw_rev == ATH12K_HW_QCN9274_HW20 &&
+	       !ar->ab->is_dualmac &&
+	       of_machine_is_compatible("jdcloud,be6500");
+}
