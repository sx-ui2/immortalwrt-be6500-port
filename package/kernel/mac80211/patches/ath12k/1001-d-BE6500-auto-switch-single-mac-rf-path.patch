+static bool ath12k_mac_be6500_5g_union(struct ath12k *ar, u32 phy_id,
+				       u32 *freq_low, u32 *freq_high)
+{
+	struct ath12k_base *ab = ar->ab;
+	struct ath12k_wmi_hal_reg_capabilities_ext_arg *pri_cap;
+	struct ath12k_wmi_hal_reg_capabilities_ext2_arg *sec_cap;
+
+	if (!ath12k_mac_be6500_auto_rf_path(ar))
+		return false;
+
+	pri_cap = &ab->hal_reg_cap[phy_id];
+	sec_cap = &ab->hal_reg_cap_ext2[phy_id];
+	if (!pri_cap->low_5ghz_chan || !pri_cap->high_5ghz_chan ||
+	    !sec_cap->low_5ghz_chan_ext || !sec_cap->high_5ghz_chan_ext)
+		return false;
+
+	*freq_low = min(pri_cap->low_5ghz_chan,
+			sec_cap->low_5ghz_chan_ext);
+	*freq_high = max(pri_cap->high_5ghz_chan,
+			 sec_cap->high_5ghz_chan_ext);
+	return true;
+}
