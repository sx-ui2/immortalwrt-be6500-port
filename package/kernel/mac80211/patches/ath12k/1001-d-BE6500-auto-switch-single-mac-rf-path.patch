+static int
+ath12k_mac_be6500_select_rf_path(struct ath12k *ar,
+				 const struct ieee80211_channel *chan)
+{
+	struct ath12k_base *ab = ar->ab;
+	struct ath12k_wmi_hal_reg_capabilities_ext2_arg *sec_cap;
+	u32 phy_id, target;
+	int ret;
+
+	if (!chan || chan->band != NL80211_BAND_5GHZ ||
+	    !ath12k_mac_be6500_auto_rf_path(ar) ||
+	    !ath12k_is_rf_path_switch_supported(ar))
+		return 0;
+
+	phy_id = ab->hw_params->single_pdev_only ?
+		ar->pdev->cap.band[WMI_HOST_WLAN_5GHZ_CAP].phy_id :
+		ar->pdev_idx;
+	sec_cap = &ab->hal_reg_cap_ext2[phy_id];
+	target = chan->center_freq >= sec_cap->low_5ghz_chan_ext ?
+		ATH12K_RF_PATH_HIGH_RANGE : ATH12K_RF_PATH_FULL_RANGE;
+
+	ret = ath12k_mac_handle_rf_path_switch(ar, target);
+	if (!ret)
+		ath12k_info(ab,
+			    "JDC-BE6500 channel %u MHz uses %s 5G RF path (index %u)\n",
+			    chan->center_freq,
+			    target == ATH12K_RF_PATH_HIGH_RANGE ? "high" : "low",
+			    target);
+
+	return ret;
+}
