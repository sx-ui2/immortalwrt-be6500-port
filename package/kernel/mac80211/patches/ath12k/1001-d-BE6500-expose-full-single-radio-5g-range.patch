+/* The factory 0x2 personality is one complete 5 GHz radio.  Firmware reports
+ * its primary and extension ranges separately because the same target also
+ * supports the 0x1008 split personality.  Merge only the advertised limits;
+ * do not issue the optional runtime RF-path switch command.
+ */
+static bool ath12k_mac_be6500_full_5g(struct ath12k *ar)
+{
+	return ar->ab->hw_rev == ATH12K_HW_QCN9274_HW20 &&
+	       !ar->ab->is_dualmac &&
+	       of_machine_is_compatible("jdcloud,be6500");
+}
+
+static bool ath12k_mac_be6500_5g_union(struct ath12k *ar, u32 phy_id,
+				       u32 *freq_low, u32 *freq_high)
+{
+	struct ath12k_base *ab = ar->ab;
+	struct ath12k_wmi_hal_reg_capabilities_ext_arg *pri_cap;
+	struct ath12k_wmi_hal_reg_capabilities_ext2_arg *sec_cap;
+
+	if (!ath12k_mac_be6500_full_5g(ar))
+		return false;
+
+	pri_cap = &ab->hal_reg_cap[phy_id];
+	sec_cap = &ab->hal_reg_cap_ext2[phy_id];
+	if (!pri_cap->low_5ghz_chan || !pri_cap->high_5ghz_chan ||
+	    !sec_cap->low_5ghz_chan_ext || !sec_cap->high_5ghz_chan_ext)
+		return false;
+
+	*freq_low = min(pri_cap->low_5ghz_chan, sec_cap->low_5ghz_chan_ext);
+	*freq_high = max(pri_cap->high_5ghz_chan, sec_cap->high_5ghz_chan_ext);
+	return true;
+}
