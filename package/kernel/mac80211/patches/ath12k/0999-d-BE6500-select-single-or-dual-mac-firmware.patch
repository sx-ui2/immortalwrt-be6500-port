+static bool ath12k_be6500_singlemac_requested(struct ath12k_base *ab)
+{
+	static const char option[] = "cnss2.bdf_pci1=";
+	const char *value;
+
+	if (ab->hw_rev != ATH12K_HW_QCN9274_HW20 ||
+	    !of_machine_is_compatible("jdcloud,be6500"))
+		return false;
+
+	value = strstr(saved_command_line, option);
+	if (!value)
+		return false;
+
+	value += sizeof(option) - 1;
+	return !strncmp(value, "0x2", 3) &&
+	       (value[3] == '\0' || value[3] == ' ');
+}
